{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "../../..",
  "roots": ["<rootDir>/apps/platform/test"],
  "testRegex": ".*\\.int-spec\\.ts$",
  "transform": { "^.+\\.(t|j)s$": "ts-jest" },
  "testEnvironment": "node",
  "testTimeout": 90000,
  "setupFiles": ["<rootDir>/setup-jest.mjs"],
  "moduleNameMapper": {
    "^@pbl/auth(|/.*)$": "<rootDir>/libs/auth/src$1",
    "^@pbl/common(|/.*)$": "<rootDir>/libs/common/src$1",
    "^@pbl/contracts(|/.*)$": "<rootDir>/libs/contracts/src$1",
    "^@pbl/events(|/.*)$": "<rootDir>/libs/events/src$1",
    "^@/(.*)$": "<rootDir>/apps/platform/src/$1"
  }
}
