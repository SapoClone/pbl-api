##== Environment
NODE_ENV=development

##== Application
APP_NAME="pbl-api platform"
APP_URL=http://localhost:3000
APP_PORT=3000
APP_DEBUG=true
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_LOG_LEVEL=debug
APP_LOG_SERVICE=console
APP_CORS_ORIGIN=http://localhost:3000,http://localhost:8080

##== Database
DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=pbl
DATABASE_SCHEMA=platform
DATABASE_LOGGING=true
DATABASE_SYNCHRONIZE=true
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=

##== Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

##== Queue (AWS SQS — pbl-mail-service Lambda consumes this)
# Placeholder for local dev — không cần SQS thật để chạy API, chỉ cần pass validation isUrl.
SQS_QUEUE_URL=https://sqs.ap-southeast-1.amazonaws.com/000000000000/local-placeholder
AWS_REGION=ap-southeast-1

##== Observe (observe.nestjs.com)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

##== Authentication
AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=1d
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=365d
AUTH_FORGOT_SECRET=secret_for_forgot
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=secret_for_confirm_email
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
