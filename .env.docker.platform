##== Environment
NODE_ENV=development

##== Application
APP_NAME="pbl-api platform"
APP_URL=http://localhost:3000
APP_PORT=3000
APP_DEBUG=true
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_LOG_LEVEL=debug
APP_LOG_SERVICE=console
APP_CORS_ORIGIN=http://localhost:3000,http://localhost:8080

##== Database
DATABASE_TYPE=postgres
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=pbl
DATABASE_SCHEMA=platform
DATABASE_LOGGING=true
DATABASE_SYNCHRONIZE=true
DATABASE_MAX_CONNECTIONS=100
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=

##== Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TLS_ENABLED=false

##== Queue (AWS SQS — pbl-mail-service Lambda consumes this)
# Local dev: ElasticMQ container from docker-compose (SQS-compatible), so
# register works without AWS. The SDK picks up AWS_ENDPOINT_URL_SQS itself;
# the keys are dummies — ElasticMQ ignores them, but the SDK needs some to sign.
SQS_QUEUE_URL=http://elasticmq:9324/000000000000/email-verification
AWS_REGION=ap-southeast-1
AWS_ENDPOINT_URL_SQS=http://elasticmq:9324
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

##== Observe (observe.nestjs.com)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=

##== Authentication
# LOCAL DEVELOPMENT KEY ONLY — committed on purpose so the docker stack works
# out of the box. Never use it anywhere else: production gets its own key from
# SSM (pbl-infra). Base64 of a PEM RSA private key (ADR-0004).
AUTH_JWT_PRIVATE_
# "kid" of the key above; change it whenever the key changes
AUTH_JWT_KEY_ID=local-dev-1
AUTH_JWT_ISSUER=platform
AUTH_JWT_AUDIENCE=pbl6
AUTH_JWT_TOKEN_EXPIRES_IN=1d
AUTH_REFRESH_SECRET=secret_for_refresh
AUTH_REFRESH_TOKEN_EXPIRES_IN=365d
AUTH_FORGOT_SECRET=secret_for_forgot
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=secret_for_confirm_email
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
