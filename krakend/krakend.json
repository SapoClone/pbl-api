        "Content-Type",
        "Accept",
        "Accept-Language",
        "x-lang",
        "X-User-Id",
        "X-Session-Id",
        "X-Subject-Type",
        "X-Tenant-Id",
        "X-Roles",
        "X-Request-Id"
