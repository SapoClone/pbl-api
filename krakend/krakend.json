        }
      ],
      "extra_config": {
        "auth/validator": {
          "alg": "RS256",
          "jwk_url": "http://platform:3000/.well-known/jwks.json",
          "disable_jwk_security": true,
          "cache": true,
          "cache_duration": 900,
          "issuer": "platform",
          "audience": [
            "pbl6"
          ],
          "propagate_claims": [
            [
              "sub",
              "X-User-Id"
            ],
            [
              "sid",
              "X-Session-Id"
            ],
            [
              "sub_type",
              "X-Subject-Type"
            ],
            [
              "tid",
              "X-Tenant-Id"
            ],
            [
              "roles",
              "X-Roles"
            ]
          ]
        }
      }
