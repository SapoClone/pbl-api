{
  "$schema": "https://www.krakend.io/schema/v2.6/krakend.json",
  "version": 3,
  "name": "pbl6-local-gateway",
  "port": 8080,
  "timeout": "10s",
  "cache_ttl": "0s",
  "plugin": {
    "pattern": ".so",
    "folder": "/opt/krakend/plugins/"
  },
  "extra_config": {
    "security/cors": {
      "allow_origins": [
        "http://localhost:5173",
        "http://localhost:3000"
      ],
      "allow_methods": [
        "GET",
        "HEAD",
        "POST",
        "PUT",
        "PATCH",
        "DELETE"
      ],
      "allow_headers": [
        "Authorization",
        "Content-Type",
        "Accept",
        "Accept-Language",
        "x-lang",
        "X-Request-Id"
      ],
      "expose_headers": [
        "Content-Length",
        "Content-Type",
        "X-Request-Id"
      ],
      "allow_credentials": true,
      "max_age": "12h"
    },
    "plugin/http-server": {
      "name": [
        "pbl-error-body"
      ]
    },
    "router": {
      "error_body": {
        "404": {
          "error": "Not Found",
          "message": "Route not found"
        },
        "405": {
          "error": "Method Not Allowed",
          "message": "Method not allowed"
        }
      }
    }
  },
  "endpoints": [
    {
      "endpoint": "/platform",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [
        "Authorization",
        "Content-Type",
        "Accept",
        "Accept-Language",
        "x-lang",
        "X-Request-Id"
      ],
      "input_query_strings": [
        "*"
      ],
      "backend": [
        {
          "url_pattern": "/",
          "encoding": "no-op",
          "host": [
            "http://platform:3000"
          ],
          "extra_config": {
            "qos/circuit-breaker": {
              "name": "platform-cb",
              "interval": 60,
              "timeout": 10,
              "max_errors": 5,
              "log_status_change": true
            }
          }
        }
      ]
    },
    {
      "endpoint": "/platform/health",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [
        "Authorization",
        "Content-Type",
        "Accept",
        "Accept-Language",
        "x-lang",
        "X-Request-Id"
      ],
      "input_query_strings": [
        "*"
      ],
      "backend": [
        {
          "url_pattern": "/health",
          "encoding": "no-op",
          "host": [
            "http://platform:3000"
          ],
          "extra_config": {
            "qos/circuit-breaker": {
              "name": "platform-cb",
              "interval": 60,
              "timeout": 10,
              "max_errors": 5,
              "log_status_change": true
            }
          }
        }
      ]
    },
    {
      "endpoint": "/platform/.well-known/jwks.json",
      "method": "GET",
      "output_encoding": "no-op",
      "input_headers": [
        "Authorization",
        "Content-Type",
        "Accept",
        "Accept-Language",
