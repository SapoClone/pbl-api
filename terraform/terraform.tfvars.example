# Copy to terraform.tfvars (gitignored) and fill in real values.

project_id   = "CHANGE_ME"       # gcloud projects create pbl-api-<random>
github_owner = "<GITHUB_OWNER>"
github_repo  = "<GITHUB_REPO>"

# tfvars files can't call merge(), so to override values from the
# non_secret_env default in variables.tf, copy the whole map here and
# edit the fields you need, e.g. DATABASE_HOST/DATABASE_USERNAME/
# DATABASE_NAME/REDIS_HOST once you have your Neon/Upstash values.
