  "info": {
    "title": "SapoClone - integration service",
    "description": "OpenAPI specification of the integration microservice",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CreateChannelConnectionDto": {
        "type": "object",
        "properties": {
          "provider": {
            "type": "string",
            "enum": [
              "SHOPEE",
              "LAZADA"
            ]
          },
          "externalShopId": {
            "type": "string",
            "maxLength": 128
          },
          "shopName": {
            "type": "string",
            "maxLength": 160
          },
          "branchId": {
            "type": "string",
            "format": "uuid"
          },
          "warehouseId": {
            "type": "string",
            "format": "uuid"
          },
          "safetyStockBuffer": {
            "type": "number",
            "minimum": 0
          },
          "stockAllocationPercent": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "webhookSecret": {
            "type": "string",
            "maxLength": 256
          },
          "partnerId": {
            "type": "string",
            "maxLength": 128
          },
          "accessToken": {
            "type": "string",
            "maxLength": 512
          },
          "refreshToken": {
            "type": "string",
            "maxLength": 512
          }
        },
        "required": [
          "provider",
          "externalShopId",
          "shopName",
          "branchId",
          "webhookSecret"
        ]
      },
      "AuthorizeChannelConnectionDto": {
        "type": "object",
        "properties": {
          "redirectUri": {
            "type": "string",
            "maxLength": 500
          },
          "authorizationCode": {
            "type": "string",
            "maxLength": 256
          },
          "stateNonce": {
            "type": "string",
            "maxLength": 128
          },
          "externalShopId": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "RefreshConnectionTokenDto": {
        "type": "object",
        "properties": {
          "workerId": {
            "type": "string",
            "maxLength": 128
          }
        }
      },
      "CreateSkuMappingDto": {
        "type": "object",
        "properties": {
          "connectionId": {
            "type": "string",
            "format": "uuid"
          },
          "externalItemId": {
            "type": "string",
            "maxLength": 128
          },
          "externalSkuId": {
            "type": "string",
            "maxLength": 128
          },
          "externalSkuCode": {
            "type": "string",
            "maxLength": 128
          },
          "externalProductName": {
            "type": "string",
            "maxLength": 255
          },
          "internalVariantId": {
            "type": "string",
            "format": "uuid"
          },
          "externalPrice": {
            "type": "number",
            "minimum": 0
          },
          "mappingMode": {
            "type": "string",
            "enum": [
              "MANUAL",
              "EXACT_SKU_AUTO"
            ]
          }
        },
        "required": [
          "connectionId",
          "externalItemId",
          "externalSkuId",
          "internalVariantId"
        ]
      },
      "SkuMappingEntity": {
        "type": "object",
        "properties": {}
      },
      "UpdateSkuMappingDto": {
        "type": "object",
        "properties": {
          "internalVariantId": {
            "type": "string",
            "format": "uuid"
          },
          "externalSkuCode": {
            "type": "string",
            "maxLength": 128
          },
          "externalProductName": {
            "type": "string",
            "maxLength": 255
          },
          "status": {
            "type": "string",
            "enum": [
              "ACTIVE",
              "INACTIVE",
              "CONFLICT",
              "NEEDS_REVIEW"
            ]
          },
          "externalPrice": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "TriggerConnectionSyncDto": {
        "type": "object",
        "properties": {
          "idempotencyKey": {
            "type": "string",
            "maxLength": 128
          },
          "externalOrderId": {
            "type": "string",
            "maxLength": 128
          },
          "executeImmediately": {
            "type": "boolean"
          }
        }
      },
      "SyncJobEntity": {
        "type": "object",
        "properties": {}
      },
      "RetrySyncJobDto": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "maxLength": 255
          },
          "executeImmediately": {
            "type": "boolean"
          }
        }
      },
      "SyncConflictEntity": {
        "type": "object",
        "properties": {}
      },
      "ResolveSyncConflictDto": {
        "type": "object",
        "properties": {
          "resolutionStatus": {
            "type": "string",
            "enum": [
              "RESOLVED",
              "IGNORED"
            ]
          },
          "resolutionAction": {
            "type": "string",
            "maxLength": 64
          },
          "resolutionNotes": {
            "type": "string",
            "maxLength": 500
          },
          "internalVariantId": {
            "type": "string",
            "format": "uuid"
          },
          "retryAfterResolve": {
            "type": "boolean"
          }
        },
        "required": [
          "resolutionStatus",
          "resolutionAction"
        ]
      },
      "RetrySyncConflictDto": {
        "type": "object",
        "properties": {
          "notes": {
            "type": "string",
            "maxLength": 255
          }
        }
      },
      "TriggerReconciliationRunDto": {
        "type": "object",
        "properties": {
          "connectionId": {
            "type": "string",
            "format": "uuid"
          },
          "runType": {
            "type": "string",
            "enum": [
              "INCREMENTAL",
              "FULL",
              "ORDER_VERIFICATION",
              "INVENTORY_VERIFICATION"
            ]
          },
          "autoRecoverSafeItems": {
            "type": "boolean"
          }
        }
      },
      "IntegrationReconciliationRunEntity": {
        "type": "object",
        "properties": {}
      }
    }
  }
