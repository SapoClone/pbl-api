{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "root": "apps/platform",
  "sourceRoot": "apps/platform/src",
  "compilerOptions": {
    "builder": "tsc",
    "typeCheck": true,
    "deleteOutDir": true,
    "webpack": false,
    "tsConfigPath": "apps/platform/tsconfig.app.json"
  },
  "projects": {
    "platform": {
      "type": "application",
      "root": "apps/platform",
      "entryFile": "main",
      "sourceRoot": "apps/platform/src",
      "compilerOptions": {
        "tsConfigPath": "apps/platform/tsconfig.app.json",
        "assets": [
          { "include": "i18n/**/*", "watchAssets": true },
          { "include": "**/*.hbs", "watchAssets": true }
        ]
      }
    }
  }
}
